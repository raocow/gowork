#autoload
#
# Completion for `gp fork` — the subcommand, then its flags and -b values.
# `pr` takes `gh pr create`'s own flags, so it completes nothing of its own.
if (( CURRENT == 2 )); then
  local -a subs=(
    'sync:catch the base up with upstream, here and on origin'
    'status:compare with upstream; branches it does not have'
    'pr:open a pull request from this branch to upstream'
  )
  _describe 'fork command' subs; return
fi
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _message -r 'not inside a git repository'; return
fi
case ${words[CURRENT-1]} in
  -b|--base) _gitplus_branch_names; return ;;
esac
case ${words[2]} in
  sync)   _alternative 'flags:Flag:(-b --base -n --dry-run -h --help)' ;;
  status) _alternative 'flags:Flag:(-b --base -h --help)' ;;
esac
