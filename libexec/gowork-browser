#!/usr/bin/env bash
# gw browser — open GitHub links in the browser (or Chrome profile) signed in
# to the right account.
#
#   gw browser setup          pick a Chrome profile per account, write the rules
#   gw browser sync           rewrite the rules from current bindings (no questions)
#   gw browser status         what's set up
#   gw browser off            remove the rules, restoring any ~/.finicky.js from before
#   gw browser open <account> <url>    open <url> in <account>'s profile
#   gw browser add <account> <host[/path]>   your own rule: that host to that account
#   gw browser add <account> --app <name>    links clicked in that app to that account
#   gw browser remove <host[/path]> | --app <name>
#   gw browser rules          list your own rules
#
# A link clicked in a terminal goes to macOS's default browser, in whichever
# profile was used last — so a client org's repo opens signed in as the wrong
# account. Finicky (MIT, https://github.com/johnste/finicky) sits in as the
# default browser and forwards each URL by rules; this generates those rules
# from gowork's accounts: each account's own login, its GitHub orgs, and the
# owners of the repos bound to it all go to that account's profile.
set -eo pipefail

_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
ACCT="$ROOT/bin/gp-account"

MAP="${GOWORK_BROWSER_MAP:-$HOME/.config/rigor/browser}"
# Your own rules, "<account>\t<url|app>\t<pattern>" per line: a host (glob
# "*.example.com" also matching example.com) with an optional path prefix, or
# the name or bundle id of the app a link was clicked in.
RULES="${GOWORK_BROWSER_RULES:-$HOME/.config/rigor/browser-rules}"
FINICKY_CONF="${GOWORK_FINICKY_CONF:-$HOME/.finicky.js}"
LOCAL_STATE="${GOWORK_CHROME_STATE:-$HOME/Library/Application Support/Google/Chrome/Local State}"
FINICKY_APP="${GOWORK_FINICKY_APP:-/Applications/Finicky.app}"
MARK="// generated by gowork (gw browser sync) — edits here are overwritten"
CHROME="Google Chrome"

die() { echo "gw browser: $*" >&2; exit 1; }

# Where a link can go, one "<browser>\t<profile dir>\t<profile name>" per line:
# each Chrome profile (read from Chrome's Local State), then every other
# browser installed, whole ("-" for no profile). Some browsers — Island, for
# one — keep their settings encrypted, so their profiles can't be listed;
# they're offered as the app itself.
OTHER_BROWSERS=("Island" "Safari" "Firefox" "Arc" "Brave Browser" "Microsoft Edge" "Vivaldi" "Orion" "Zen" "Chromium")
choices() {
  if [ -r "$LOCAL_STATE" ]; then
    perl -MJSON::PP -e '
      local $/; my $d = eval { JSON::PP->new->decode(<STDIN>) } or exit 0;
      my $c = $d->{profile}{info_cache} || {};
      print "Google Chrome\t$_\t$c->{$_}{name}\n" for sort keys %$c;
    ' < "$LOCAL_STATE" || true
  fi
  local b
  for b in "${OTHER_BROWSERS[@]}"; do
    if [ -d "${GOWORK_APPS:-/Applications}/$b.app" ] || [ -d "$HOME/Applications/$b.app" ]; then
      printf '%s\t-\t-\n' "$b"
    fi
  done
}

label() {  # label <browser> <dir> <profile> -> what to show a person
  if [ "$2" = "-" ]; then echo "$1"; else echo "$1 — $3"; fi
}

# The saved map, normalized to "<account>\t<browser>\t<dir>\t<profile>".
# Lines written before other browsers were supported had three fields
# (account, Chrome profile dir, profile name).
map_rows() {
  [ -f "$MAP" ] || return 0
  awk -F'\t' -v c="$CHROME" 'NF == 3 { print $1 "\t" c "\t" $2 "\t" $3; next } NF >= 4 { print $1 "\t" $2 "\t" $3 "\t" $4 }' "$MAP"
}

map_get() {  # map_get <account or its gh user> -> "<browser>\t<dir>\t<profile>"
  local a="$1"
  if ! map_rows | awk -F'\t' -v a="$a" '$1 == a { f = 1 } END { exit !f }'; then
    # Callers that only know the GitHub login (gh's active account) may pass
    # that instead of gowork's account name.
    local n; n="$(acct_list | awk -v u="$a" '/^[^ ]/ { cur = $1 } $1 == "gh:" && $2 == u && !d { print cur; d = 1 }')"
    [ -n "$n" ] && a="$n"
  fi
  map_rows | awk -F'\t' -v a="$a" '$1 == a && !f { print $2 "\t" $3 "\t" $4; f = 1 } END { exit !f }'
}

# Read `gp-account list` once. Piping it straight into an awk that stops at its
# first match made gp-account die of SIGPIPE on a long list, and with
# pipefail + set -e that ended this script silently.
_LIST=""
acct_list() { [ -n "$_LIST" ] || _LIST="$("$ACCT" list 2>/dev/null || true)"; printf '%s\n' "$_LIST"; }
accounts()   { acct_list | awk '/^[^ ]/ { print $1 }'; }
ghuser_of()  { acct_list | awk -v a="$1" '/^[^ ]/ { cur = $1 } cur == a && $1 == "gh:" && !done { print $2; done = 1 }'; }
bound_dirs() { acct_list | awk -v a="$1" '/^[^ ]/ { cur = $1; next } cur == a && $1 != "gh:" { print $1 }' | sed "s|^~|$HOME|"; }

# Owners whose GitHub pages belong to <account>: its login, its orgs, and the
# owners of its bound repos.
owners_of() {
  local a="$1" u tok d c slug
  u="$(ghuser_of "$a")"
  {
    [ -n "$u" ] && echo "$u"
    if [ -n "$u" ] && command -v gh >/dev/null 2>&1; then
      tok="$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com --user "$u" 2>/dev/null || true)"
      [ -n "$tok" ] && GH_TOKEN="$tok" gh api user/orgs --jq '.[].login' 2>/dev/null || true
    fi
    while IFS= read -r d; do
      [ -d "$d" ] || continue
      for c in "$d" "$d"/*; do
        [ -d "$c/.git" ] || continue
        # Same parse as gp-account: https, scp-style and ssh:// remotes,
        # including gowork's own github.com-<account> ssh aliases.
        local url u host path
        url="$(git -C "$c" remote get-url origin 2>/dev/null || true)"
        [ -n "$url" ] || continue
        u="${url#*://}"; u="${u#*@}"; host="${u%%[:/]*}"; path="${u#*[:/]}"
        case "$host" in github.com|github.com-*) echo "${path%%/*}" ;; esac
      done
    done < <(bound_dirs "$a")
  } | awk 'NF && !seen[tolower($0)]++'
}

js_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

browser_js() {  # browser_js <browser> <dir> <profile> -> a Finicky browser value
  if [ "$2" = "-" ]; then printf '{ name: %s }' "$(js_str "$1")"
  else printf '{ name: %s, profile: %s }' "$(js_str "$1")" "$(js_str "$3")"; fi
}

# Write ~/.finicky.js from the saved account -> profile map.
sync() {
  [ -f "$MAP" ] || die "not set up — run: gw browser setup"
  if [ -f "$FINICKY_CONF" ] && ! head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    cp "$FINICKY_CONF" "$FINICKY_CONF.gowork-bak"
    echo "kept your previous ${FINICKY_CONF/#$HOME/~} as ${FINICKY_CONF/#$HOME/~}.gowork-bak"
  fi
  local a b dir prof o rules="" taken="" claimed defjs m
  if m="$(map_get default 2>/dev/null)"; then
    IFS=$'\t' read -r b dir prof <<< "$m"; defjs="$(browser_js "$b" "$dir" "$prof")"
  else
    defjs="$(js_str "$CHROME")"
  fi
  while IFS=$'\t' read -r a b dir prof; do
    [ "$a" = default ] && continue
    while IFS= read -r o; do
      # An owner two accounts can both see (a shared org) goes to the first
      # account that claims it, and is reported — not split unpredictably.
      claimed="$(printf '%s' "$taken" | awk -F'\t' -v o="$(printf '%s' "$o" | tr 'A-Z' 'a-z')" '$1 == o && !d { print $2; d = 1 }')"
      if [ -n "$claimed" ]; then
        [ "$claimed" != "$a" ] && echo "note: github.com/$o is reachable by $claimed and $a; it opens as $claimed"
        continue
      fi
      taken="$taken$(printf '%s' "$o" | tr 'A-Z' 'a-z')	$a
"
      rules="$rules    $(js_str "$(printf '%s' "$o" | tr 'A-Z' 'a-z')"): $(browser_js "$b" "$dir" "$prof"),
"
    done < <(owners_of "$a")
  done < <(map_rows)

  # Your own rules, resolved to the browser of the account they name.
  local kind pat urlrules="" apprules="" host path
  if [ -f "$RULES" ]; then
    while IFS=$'\t' read -r a kind pat; do
      [ -n "$a" ] || continue
      if ! m="$(map_get "$a" 2>/dev/null)"; then
        echo "note: skipping rule for '$a' ($pat): no browser chosen for it — gw browser setup" >&2; continue
      fi
      IFS=$'\t' read -r b dir prof <<< "$m"
      if [ "$kind" = app ]; then
        apprules="$apprules    { app: $(js_str "$(printf '%s' "$pat" | tr 'A-Z' 'a-z')"), browser: $(browser_js "$b" "$dir" "$prof") },
"
      else
        host="${pat%%/*}"; path=""; [ "$host" != "$pat" ] && path="/${pat#*/}"
        urlrules="$urlrules    { host: $(js_str "$(printf '%s' "$host" | tr 'A-Z' 'a-z')"), path: $(js_str "$path"), browser: $(browser_js "$b" "$dir" "$prof") },
"
      fi
    done < "$RULES"
  fi

  local tmp; tmp="$(mktemp "$FINICKY_CONF.gowork.XXXXXX")"
  cat > "$tmp" <<EOF
$MARK
// Source: ~/.config/rigor/browser (account -> browser and profile) and
// gowork's account bindings. To change it: gw browser setup, or gw browser
// sync after binding new repos.

// Checked in this order; the first that matches decides.
// 1. Your URL rules (gw browser add <account> <host[/path]>).
const urlRules = [
${urlrules}];
// 2. GitHub owner (user or org, lowercased) -> where its pages open.
const owners = {
${rules}};
// 3. Your app rules (gw browser add <account> --app <name>): the app the link
//    was clicked in, by name or bundle id, lowercased.
const appRules = [
${apprules}];

// "*.example.com" matches example.com and every subdomain of it.
const hostMatch = (host, pat) =>
  pat.startsWith("*.") ? host === pat.slice(2) || host.endsWith(pat.slice(1)) : host === pat;
const hostOf = (url) => (url.hostname || url.host || "").toLowerCase();

let picked;   // set by a match, returned by its browser
const pick = (b) => { picked = b; return Boolean(b); };

export default {
  defaultBrowser: ${defjs},
  handlers: [
    {
      match: (url) => pick(urlRules.find((r) =>
        hostMatch(hostOf(url), r.host) && url.pathname.startsWith(r.path || "/"))?.browser),
      browser: () => picked,
    },
    {
      match: (url) => {
        if (hostOf(url) !== "github.com") return false;
        const owner = url.pathname.split("/")[1]?.toLowerCase();
        return pick(owner && owners[owner]);
      },
      browser: () => picked,
    },
    {
      match: (url, options) => {
        const o = options && options.opener;
        if (!o) return false;
        const ids = [o.name, o.bundleId].filter(Boolean).map((s) => s.toLowerCase());
        return pick(appRules.find((r) => ids.includes(r.app))?.browser);
      },
      browser: () => picked,
    },
  ],
};
EOF
  # In place, not mv: Finicky watches the file it loaded, and a rename swaps a
  # new file in under it, so every later change goes unnoticed (its cached
  # config stayed a day old). Skipped when nothing changed.
  if [ -f "$FINICKY_CONF" ] && cmp -s "$tmp" "$FINICKY_CONF"; then
    rm -f "$tmp"
  else
    cat "$tmp" > "$FINICKY_CONF"
    rm -f "$tmp"
  fi
  echo "wrote ${FINICKY_CONF/#$HOME/~} ($(printf '%s' "$rules" | grep -c . || true) GitHub owner(s), $(printf '%s' "$urlrules" | grep -c . || true) URL rule(s), $(printf '%s' "$apprules" | grep -c . || true) app rule(s))"
}

setup() {
  [ "$(uname -s)" = Darwin ] || die "macOS only (Finicky is a macOS app)"
  [ -t 0 ] && [ -t 1 ] || die "setup asks questions; run it in a terminal"
  if [ ! -d "$FINICKY_APP" ]; then
    printf 'Finicky (MIT, a small browser router) is not installed. Install it with Homebrew? [y/N] '
    local ans; read -r ans || ans=""
    case "$ans" in y|Y|yes) brew install --cask finicky ;; *) die "Finicky is needed; nothing changed" ;; esac
  fi
  exec 3<&0    # answers come from the terminal; the loops below own stdin
  local profiles; profiles="$(choices)"
  [ -n "$profiles" ] || die "no browsers found (looked for Chrome profiles and ${OTHER_BROWSERS[*]})"

  echo "Where links can open:"
  local i=0 line b d p
  while IFS=$'\t' read -r b d p; do i=$((i + 1)); printf '  %d) %s\n' "$i" "$(label "$b" "$d" "$p")"; done <<< "$profiles"
  pick() {  # pick <prompt> -> "<browser>\t<dir>\t<profile>" or empty
    # The prompt goes to stderr: pick runs inside $(…), which captures stdout.
    local n; printf '%s ' "$1" >&2; read -r n <&3 || n=""
    [ -n "$n" ] || return 0
    printf '%s\n' "$profiles" | sed -n "${n}p"
  }

  local tmp; tmp="$(mktemp)"
  local a u choice
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    u="$(ghuser_of "$a")"
    choice="$(pick "Where are you signed in to GitHub as ${u:-$a}? (number, Enter to skip)")"
    [ -n "$choice" ] && printf '%s\t%s\n' "$a" "$choice" >> "$tmp"
  done < <(accounts)
  choice="$(pick "Where should every other link open? (number, Enter for Chrome's own choice)")"
  [ -n "$choice" ] && printf 'default\t%s\n' "$choice" >> "$tmp"
  mkdir -p "$(dirname "$MAP")"
  mv "$tmp" "$MAP"
  sync
  echo ""
  echo "Opening Finicky — if it asks, let it become your default browser."
  open -a "$FINICKY_APP" 2>/dev/null || true
}

status() {
  if [ ! -f "$MAP" ]; then echo "not set up — run: gw browser setup"; return 0; fi
  [ -d "$FINICKY_APP" ] && echo "finicky   : installed" || echo "finicky   : NOT installed (brew install --cask finicky)"
  if [ -f "$FINICKY_CONF" ] && head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    echo "rules     : ${FINICKY_CONF/#$HOME/~} (gowork's)"
  else
    echo "rules     : ${FINICKY_CONF/#$HOME/~} is not gowork's — run: gw browser sync"
  fi
  local a b dir prof
  while IFS=$'\t' read -r a b dir prof; do printf '  %-14s -> %s\n' "$a" "$(label "$b" "$dir" "$prof")"; done < <(map_rows)
}

off() {
  if [ -f "$FINICKY_CONF" ] && head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    if [ -f "$FINICKY_CONF.gowork-bak" ]; then
      mv "$FINICKY_CONF.gowork-bak" "$FINICKY_CONF"; echo "restored your previous ${FINICKY_CONF/#$HOME/~}"
    else
      rm -f "$FINICKY_CONF"; echo "removed ${FINICKY_CONF/#$HOME/~}"
    fi
  fi
  rm -f "$MAP"
  echo "Finicky itself is still installed and may still be the default browser:"
  echo "  pick another in System Settings > Desktop & Dock > Default web browser"
}

# gw browser add <account> <host[/path]> | --app <name>
add_rule() {
  local a="${1:-}" kind=url pat="${2:-}"
  if [ "$pat" = "--app" ]; then kind=app; pat="${3:-}"; fi
  [ -n "$a" ] && [ -n "$pat" ] || die "usage: gw browser add <account> <host[/path]> | --app <name>"
  map_get "$a" >/dev/null 2>&1 || die "no browser chosen for '$a' yet — gw browser setup"
  if [ "$kind" = url ]; then
    # Accept a pasted URL too: keep host and path, drop scheme, query, fragment.
    pat="${pat#*://}"; pat="${pat%%[?#]*}"; pat="${pat%/}"
    case "$pat" in *[[:space:]]*|"") die "not a host or URL: $pat" ;; esac
  fi
  mkdir -p "$(dirname "$RULES")"; touch "$RULES"
  local tmp; tmp="$(mktemp "$RULES.XXXXXX")"
  awk -F'\t' -v k="$kind" -v p="$pat" '!($2 == k && $3 == p)' "$RULES" > "$tmp"
  printf '%s\t%s\t%s\n' "$a" "$kind" "$pat" >> "$tmp"
  mv "$tmp" "$RULES"
  if [ "$kind" = app ]; then echo "added: links clicked in $pat -> $a"; else echo "added: $pat -> $a"; fi
  [ -f "$MAP" ] && sync
}

remove_rule() {
  local kind=url pat="${1:-}"
  if [ "$pat" = "--app" ]; then kind=app; pat="${2:-}"; fi
  [ -n "$pat" ] || die "usage: gw browser remove <host[/path]> | --app <name>"
  [ "$kind" = url ] && { pat="${pat#*://}"; pat="${pat%%[?#]*}"; pat="${pat%/}"; }
  awk -F'\t' -v k="$kind" -v p="$pat" '$2 == k && $3 == p { f = 1 } END { exit !f }' "$RULES" 2>/dev/null \
    || die "no such rule: $pat"
  local tmp; tmp="$(mktemp "$RULES.XXXXXX")"
  awk -F'\t' -v k="$kind" -v p="$pat" '!($2 == k && $3 == p)' "$RULES" > "$tmp"
  mv "$tmp" "$RULES"
  echo "removed: $pat"
  [ -f "$MAP" ] && sync
}

list_rules() {
  if [ ! -s "$RULES" ]; then
    echo "no rules of your own; GitHub links are routed by account (gw browser status)"
    return 0
  fi
  local a kind pat
  while IFS=$'\t' read -r a kind pat; do
    if [ "$kind" = app ]; then printf '  clicked in %-28s -> %s\n' "$pat" "$a"
    else printf '  %-39s -> %s\n' "$pat" "$a"; fi
  done < "$RULES"
}

# open <account> <url> — straight into the account's profile, no Finicky
# needed. Falls back to the default browser when there's no mapping.
open_as() {
  local a="${1:-}" url="${2:-}" m b dir prof
  [ -n "$url" ] || die "usage: gw browser open <account> <url>"
  if m="$(map_get "$a" 2>/dev/null)"; then
    IFS=$'\t' read -r b dir prof <<< "$m"
    if [ "$dir" = "-" ]; then exec ${GOWORK_OPEN:-open} -a "$b" "$url"; fi
    exec ${GOWORK_OPEN:-open} -na "$b" --args --profile-directory="$dir" "$url"
  fi
  exec ${GOWORK_OPEN:-open} "$url"
}

case "${1:-}" in
  setup)  setup ;;
  sync)   sync ;;
  status) status ;;
  off)    off ;;
  open)   shift; open_as "$@" ;;
  has)    shift; map_get "${1:-}" >/dev/null 2>&1 ;;   # quiet: does this account have a browser?
  add)    shift; add_rule "$@" ;;
  remove|rm) shift; remove_rule "$@" ;;
  rules)  list_rules ;;
  *) echo "usage: gw browser setup|sync|status|off|rules|add|remove|open" >&2; exit 2 ;;
esac
