#!/usr/bin/env bash
# gw browser — open GitHub links in the browser profile signed in to the right
# account.
#
#   gw browser setup          pick a Chrome profile per account, write the rules
#   gw browser sync           rewrite the rules from current bindings (no questions)
#   gw browser status         what's set up
#   gw browser off            remove the rules, restoring any ~/.finicky.js from before
#   gw browser open <account> <url>    open <url> in <account>'s profile
#
# A link clicked in a terminal goes to macOS's default browser, in whichever
# profile was used last — so a client org's repo opens signed in as the wrong
# account. Finicky (MIT, https://github.com/johnste/finicky) sits in as the
# default browser and forwards each URL by rules; this generates those rules
# from gowork's accounts: each account's own login, its GitHub orgs, and the
# owners of the repos bound to it all go to that account's profile.
set -eo pipefail

_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
ACCT="$ROOT/bin/gp-account"

MAP="${GOWORK_BROWSER_MAP:-$HOME/.config/rigor/browser}"
FINICKY_CONF="${GOWORK_FINICKY_CONF:-$HOME/.finicky.js}"
LOCAL_STATE="${GOWORK_CHROME_STATE:-$HOME/Library/Application Support/Google/Chrome/Local State}"
FINICKY_APP="${GOWORK_FINICKY_APP:-/Applications/Finicky.app}"
MARK="// generated by gowork (gw browser sync) — edits here are overwritten"
CHROME="Google Chrome"

die() { echo "gw browser: $*" >&2; exit 1; }

# Chrome profiles as "<dir>\t<display name>", from Chrome's own Local State.
chrome_profiles() {
  [ -r "$LOCAL_STATE" ] || return 0
  perl -MJSON::PP -e '
    local $/; my $d = JSON::PP->new->decode(<STDIN>);
    my $c = $d->{profile}{info_cache} || {};
    print "$_\t$c->{$_}{name}\n" for sort keys %$c;
  ' < "$LOCAL_STATE"
}

map_get() {  # map_get <account> -> "<dir>\t<name>"
  [ -f "$MAP" ] || return 1
  awk -F'\t' -v a="$1" '$1 == a { print $2 "\t" $3; found = 1; exit } END { exit !found }' "$MAP"
}

# Read `gp-account list` once. Piping it straight into an awk that stops at its
# first match made gp-account die of SIGPIPE on a long list, and with
# pipefail + set -e that ended this script silently.
_LIST=""
acct_list() { [ -n "$_LIST" ] || _LIST="$("$ACCT" list 2>/dev/null || true)"; printf '%s\n' "$_LIST"; }
accounts()   { acct_list | awk '/^[^ ]/ { print $1 }'; }
ghuser_of()  { acct_list | awk -v a="$1" '/^[^ ]/ { cur = $1 } cur == a && $1 == "gh:" && !done { print $2; done = 1 }'; }
bound_dirs() { acct_list | awk -v a="$1" '/^[^ ]/ { cur = $1; next } cur == a && $1 != "gh:" { print $1 }' | sed "s|^~|$HOME|"; }

# Owners whose GitHub pages belong to <account>: its login, its orgs, and the
# owners of its bound repos.
owners_of() {
  local a="$1" u tok d c slug
  u="$(ghuser_of "$a")"
  {
    [ -n "$u" ] && echo "$u"
    if [ -n "$u" ] && command -v gh >/dev/null 2>&1; then
      tok="$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com --user "$u" 2>/dev/null || true)"
      [ -n "$tok" ] && GH_TOKEN="$tok" gh api user/orgs --jq '.[].login' 2>/dev/null || true
    fi
    while IFS= read -r d; do
      [ -d "$d" ] || continue
      for c in "$d" "$d"/*; do
        [ -d "$c/.git" ] || continue
        # Same parse as gp-account: https, scp-style and ssh:// remotes,
        # including gowork's own github.com-<account> ssh aliases.
        local url u host path
        url="$(git -C "$c" remote get-url origin 2>/dev/null || true)"
        [ -n "$url" ] || continue
        u="${url#*://}"; u="${u#*@}"; host="${u%%[:/]*}"; path="${u#*[:/]}"
        case "$host" in github.com|github.com-*) echo "${path%%/*}" ;; esac
      done
    done < <(bound_dirs "$a")
  } | awk 'NF && !seen[tolower($0)]++'
}

js_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# Write ~/.finicky.js from the saved account -> profile map.
sync() {
  [ -f "$MAP" ] || die "not set up — run: gw browser setup"
  if [ -f "$FINICKY_CONF" ] && ! head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    cp "$FINICKY_CONF" "$FINICKY_CONF.gowork-bak"
    echo "kept your previous ${FINICKY_CONF/#$HOME/~} as ${FINICKY_CONF/#$HOME/~}.gowork-bak"
  fi
  local def a dir name o rules="" taken="" claimed defjs
  def="$(map_get default 2>/dev/null | cut -f2 || true)"
  if [ -n "$def" ]; then defjs="chrome($(js_str "$def"))"; else defjs="$(js_str "$CHROME")"; fi
  while IFS=$'\t' read -r a dir name; do
    [ "$a" = default ] && continue
    while IFS= read -r o; do
      # An owner two accounts can both see (a shared org) goes to the first
      # account that claims it, and is reported — not split unpredictably.
      claimed="$(printf '%s' "$taken" | awk -F'\t' -v o="$(printf '%s' "$o" | tr 'A-Z' 'a-z')" '$1 == o && !d { print $2; d = 1 }')"
      if [ -n "$claimed" ]; then
        [ "$claimed" != "$a" ] && echo "note: github.com/$o is reachable by $claimed and $a; it opens as $claimed"
        continue
      fi
      taken="$taken$(printf '%s' "$o" | tr 'A-Z' 'a-z')	$a
"
      rules="$rules    $(js_str "$(printf '%s' "$o" | tr 'A-Z' 'a-z')"): $(js_str "$name"),
"
    done < <(owners_of "$a")
  done < "$MAP"

  local tmp; tmp="$(mktemp "$FINICKY_CONF.gowork.XXXXXX")"
  cat > "$tmp" <<EOF
$MARK
// Source: ~/.config/rigor/browser (account -> Chrome profile) and gowork's
// account bindings. To change it: gw browser setup, or gw browser sync after
// binding new repos.

// GitHub owner (user or org, lowercased) -> Chrome profile name.
const owners = {
${rules}};

const chrome = (profile) => ({ name: $(js_str "$CHROME"), profile });

export default {
  defaultBrowser: ${defjs},
  handlers: [
    {
      match: (url) => {
        if (url.host !== "github.com") return false;
        const owner = url.pathname.split("/")[1]?.toLowerCase();
        return Boolean(owner && owners[owner]);
      },
      browser: (url) => chrome(owners[url.pathname.split("/")[1].toLowerCase()]),
    },
  ],
};
EOF
  mv "$tmp" "$FINICKY_CONF"
  echo "wrote ${FINICKY_CONF/#$HOME/~} ($(printf '%s' "$rules" | grep -c . || true) GitHub owner(s) routed)"
}

setup() {
  [ "$(uname -s)" = Darwin ] || die "macOS only (Finicky is a macOS app)"
  [ -t 0 ] && [ -t 1 ] || die "setup asks questions; run it in a terminal"
  if [ ! -d "$FINICKY_APP" ]; then
    printf 'Finicky (MIT, a small browser router) is not installed. Install it with Homebrew? [y/N] '
    local ans; read -r ans || ans=""
    case "$ans" in y|Y|yes) brew install --cask finicky ;; *) die "Finicky is needed; nothing changed" ;; esac
  fi
  exec 3<&0    # answers come from the terminal; the loops below own stdin
  local profiles; profiles="$(chrome_profiles)"
  [ -n "$profiles" ] || die "no Chrome profiles found ($LOCAL_STATE)"

  echo "Chrome profiles:"
  local i=0 line; while IFS= read -r line; do i=$((i + 1)); printf '  %d) %s\n' "$i" "${line#*	}"; done <<< "$profiles"
  pick() {  # pick <prompt> -> "<dir>\t<name>" or empty
    # The prompt goes to stderr: pick runs inside $(…), which captures stdout.
    local n; printf '%s ' "$1" >&2; read -r n <&3 || n=""
    [ -n "$n" ] || return 0
    printf '%s\n' "$profiles" | sed -n "${n}p"
  }

  local tmp; tmp="$(mktemp)"
  local a u choice
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    u="$(ghuser_of "$a")"
    choice="$(pick "Which profile is signed in to GitHub as ${u:-$a}? (number, Enter to skip)")"
    [ -n "$choice" ] && printf '%s\t%s\n' "$a" "$choice" >> "$tmp"
  done < <(accounts)
  choice="$(pick "Which profile should every other link open in? (number, Enter for Chrome's own choice)")"
  [ -n "$choice" ] && printf 'default\t%s\n' "$choice" >> "$tmp"
  mkdir -p "$(dirname "$MAP")"
  mv "$tmp" "$MAP"
  sync
  echo ""
  echo "Opening Finicky — if it asks, let it become your default browser."
  open -a "$FINICKY_APP" 2>/dev/null || true
}

status() {
  if [ ! -f "$MAP" ]; then echo "not set up — run: gw browser setup"; return 0; fi
  [ -d "$FINICKY_APP" ] && echo "finicky   : installed" || echo "finicky   : NOT installed (brew install --cask finicky)"
  if [ -f "$FINICKY_CONF" ] && head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    echo "rules     : ${FINICKY_CONF/#$HOME/~} (gowork's)"
  else
    echo "rules     : ${FINICKY_CONF/#$HOME/~} is not gowork's — run: gw browser sync"
  fi
  local a dir name
  while IFS=$'\t' read -r a dir name; do printf '  %-14s -> %s\n' "$a" "$name"; done < "$MAP"
}

off() {
  if [ -f "$FINICKY_CONF" ] && head -1 "$FINICKY_CONF" | grep -qF "$MARK"; then
    if [ -f "$FINICKY_CONF.gowork-bak" ]; then
      mv "$FINICKY_CONF.gowork-bak" "$FINICKY_CONF"; echo "restored your previous ${FINICKY_CONF/#$HOME/~}"
    else
      rm -f "$FINICKY_CONF"; echo "removed ${FINICKY_CONF/#$HOME/~}"
    fi
  fi
  rm -f "$MAP"
  echo "Finicky itself is still installed and may still be the default browser:"
  echo "  pick another in System Settings > Desktop & Dock > Default web browser"
}

# open <account> <url> — straight into the account's profile, no Finicky
# needed. Falls back to the default browser when there's no mapping.
open_as() {
  local a="${1:-}" url="${2:-}" m dir
  [ -n "$url" ] || die "usage: gw browser open <account> <url>"
  if m="$(map_get "$a" 2>/dev/null)"; then
    dir="${m%%	*}"
    exec ${GOWORK_OPEN:-open} -na "$CHROME" --args --profile-directory="$dir" "$url"
  fi
  exec ${GOWORK_OPEN:-open} "$url"
}

case "${1:-}" in
  setup)  setup ;;
  sync)   sync ;;
  status) status ;;
  off)    off ;;
  open)   shift; open_as "$@" ;;
  *) echo "usage: gw browser setup|sync|status|off|open <account> <url>" >&2; exit 2 ;;
esac
