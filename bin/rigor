#!/usr/bin/env bash
# rigor (formerly devrig, née ezenv) — opt-in dev environment helpers.
set -eo pipefail

VERSION="1.0.0"

# Resolve this script's real location (following symlinks), then the keg/repo
# root (bin/..), so `share/rigor` is found whether run from Homebrew or source.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
SHARE="$(cd "$BIN_DIR/.." && pwd)/share/rigor"

# RIGOR_* is canonical; DEVRIG_* (pre-rename) and EZENV_* (pre-pre-rename) are
# honored as deprecated fallbacks so an existing exported override doesn't
# silently stop working.
RC="${RIGOR_RC:-${DEVRIG_RC:-${EZENV_RC:-${ZDOTDIR:-$HOME}/.zshrc}}}"

usage() {
  cat <<EOF
rigor $VERSION — opt-in dev environment helpers

Usage:
  rigor enable [feature...]      Enable feature(s) (no feature = all)
  rigor disable <feature|all>    Disable a feature (or 'all'); a feature is required
  rigor status                   Show which features are enabled
  rigor doctor                   Show current environment (python/pip/venv)
  rigor init [feature...]        Print the raw source line(s) — for eval or manual use
  rigor sleep on|off|status      Toggle 'sudo pmset -a disablesleep' (needs sudo)
  rigor push <subcommand>        Agent turn notifications on your phone
  rigor identity <subcommand>    Per-directory gh account + AWS profile, for agents too
  rigor version                 Print version
  rigor help                     Show this help

Features:
  autovenv       Auto-activate the nearest .venv when you cd into a repo
  pyf            Make bare 'python'/'pip' resolve to python3/pip3
  envup          Add an 'envup' command: export a .env into the current shell
  all            autovenv + pyf + envup (default when no feature is given)

Per-directory git/ssh/GitHub accounts moved to gitplus — see 'gp account'.
Config written by 'devrig account' (or 'rigor account') is still read there,
so nothing to redo.

Push subcommands:
  push setup [--topic T] [--device NAME] [--server URL]   Wire this machine
                                  (--device '' leaves the machine out of titles)
  push status [--show]            What is wired, and where
  push test [message]             Send one notification and read it back
  push off                        Unwire, restoring what was there before

Identity subcommands:
  identity setup                  Install gh/aws shims and put them on PATH
  identity status                 What's wired, and what applies in this dir
  identity bind <profile> [dir]   Use that AWS profile in dir and below
  identity unbind [dir]           Drop a directory's AWS binding
  identity off                    Unwire, restoring what was there before
  (gh accounts are bound with gitplus: gp account bind <name> <dir>)

Example:
  rigor enable autovenv      # then: exec zsh
  rigor sleep off            # keep the Mac awake (e.g. a long build/transfer)
  rigor sleep on             # ...then put it back
  rigor push setup           # notify your phone when an agent turn ends
EOF
}

# Stable share dir for lines written into the rc file: prefer the version-independent
# Homebrew opt path; fall back to the resolved location for source/dev runs.
# gowork is this script's formula now; rigor is the formula it used to ship
# in, still honored so a machine mid-upgrade keeps working.
share_dir() {
  local p f
  for f in gowork rigor; do
    if p="$(brew --prefix "$f" 2>/dev/null)" && [ -d "$p/share/rigor" ] \
       && [ "$(cd -P "$p/share/rigor" && pwd)" = "$(cd -P "$SHARE" && pwd)" ]; then
      echo "$p/share/rigor"; return
    fi
  done
  echo "$SHARE"
}

feature_file() {
  case "$1" in
    autovenv) echo "autovenv.zsh" ;;
    pyf)      echo "pyf.zsh" ;;
    envup)   echo "envup.zsh" ;;
    *)        return 1 ;;
  esac
}

# Echo the requested features, expanding 'all', defaulting to all when empty,
# and normalizing legacy names ('py-fallback' -> 'pyf') to their canonical form.
# 'ghswitch' used to live here too; it moved to gitplus with the account
# (and was later retired in favour of the gh shim, `rigor identity`)
# registry it depends on, and is sourced from there instead of being enabled
# by name.
expand_features() {
  if [ "$#" -eq 0 ]; then echo "autovenv pyf envup"; return; fi
  local f out=""
  for f in "$@"; do
    case "$f" in
      all)         out="$out autovenv pyf envup" ;;
      py-fallback) out="$out pyf" ;;   # legacy alias
      *)           out="$out $f" ;;
    esac
  done
  echo "$out"
}

# True if a feature is enabled in $RC. Recognizes the legacy 'py-fallback'
# marker so an rc written by an older rigor/devrig is still detected as 'pyf',
# and the pre-rename 'devrig:' and pre-pre-rename 'ezenv:' marker prefixes so
# an rc from before either rename is still detected without a manual edit.
feature_enabled() {
  [ -f "$RC" ] || return 1
  grep -qF "# rigor:$1" "$RC" && return 0
  grep -qF "# devrig:$1" "$RC" && return 0
  grep -qF "# ezenv:$1" "$RC" && return 0
  [ "$1" = pyf ] && grep -qF "# rigor:py-fallback" "$RC" && return 0
  [ "$1" = pyf ] && grep -qF "# devrig:py-fallback" "$RC" && return 0
  [ "$1" = pyf ] && grep -qF "# ezenv:py-fallback" "$RC" && return 0
  return 1
}

# --- Editor integration (autovenv only) ------------------------------------
# VSCode and its forks auto-activate the workspace's selected interpreter in
# every new terminal, workspace-wide — which fights autovenv's directory-precise
# model (it loads a venv even in dirs that have none). On `enable autovenv` we
# offer to turn that off at the user level so autovenv owns venv activation;
# `disable autovenv` offers to turn it back on. Edits are backed up (.rigor-bak).
_EDITOR_KEY='python.terminal.activateEnvironment'

_editor_settings() {  # print settings.json path for each installed editor
  local base name
  for base in "$HOME/Library/Application Support" "$HOME/.config"; do
    [ -d "$base" ] || continue
    for name in "Cursor" "Code" "Code - Insiders" "VSCodium" "Windsurf"; do
      [ -d "$base/$name/User" ] && echo "$base/$name/User/settings.json"
    done
  done
}

_editor_set_false() {  # add "<key>": false as the first entry (JSONC-safe)
  local f="$1"
  mkdir -p "$(dirname "$f")"
  if [ ! -s "$f" ]; then
    printf '{\n    "%s": false\n}\n' "$_EDITOR_KEY" > "$f"
  else
    cp "$f" "$f.rigor-bak"
    # Insert right after the first '{'. JSONC tolerates the trailing comma even
    # if this becomes the only key, so this is safe for compact or empty objects.
    RIGOR_KEY="$_EDITOR_KEY" perl -0pi -e 's/\{/\{\n    "$ENV{RIGOR_KEY}": false,/' "$f"
  fi
  echo "  ${f/#$HOME/~}: set $_EDITOR_KEY=false"
}

_editor_defer() {  # enable autovenv → offer to silence editors' auto-activation
  [ -t 0 ] || return 0
  local f todo=()
  while IFS= read -r f; do
    # A "conflict" is an editor that doesn't already set the key (respect an
    # explicit choice you've made either way).
    { [ -f "$f" ] && grep -q "$_EDITOR_KEY" "$f"; } || todo+=("$f")
  done < <(_editor_settings)
  [ "${#todo[@]}" -gt 0 ] || return 0
  printf 'VSCode and its forks, including Cursor, have their own virtual environment\n'
  printf 'automatic activation feature that may conflict with autovenv, disable it? (y/n) '
  local ans; read -r ans || return 0
  case "$ans" in
    y|Y|yes|YES) for f in "${todo[@]}"; do _editor_set_false "$f"; done ;;
    *) echo "  left editor settings unchanged." ;;
  esac
}

_editor_restore() {  # disable autovenv → offer to undo the defer
  [ -t 0 ] || return 0
  local f todo=() pat="\"$_EDITOR_KEY\"[[:space:]]*:[[:space:]]*false"
  while IFS= read -r f; do
    [ -f "$f" ] && grep -Eq "$pat" "$f" && todo+=("$f")
  done < <(_editor_settings)
  [ "${#todo[@]}" -gt 0 ] || return 0
  printf "re-enable your editor's own venv auto-activation (undo the autovenv defer)? (y/n) "
  local ans; read -r ans || return 0
  case "$ans" in
    y|Y|yes|YES)
      for f in "${todo[@]}"; do
        cp "$f" "$f.rigor-bak"
        grep -Ev "$pat" "$f" > "$f.rigor-tmp" || true
        mv "$f.rigor-tmp" "$f"
        echo "  ${f/#$HOME/~}: removed $_EDITOR_KEY=false"
      done ;;
    *) return 0 ;;
  esac
}


cmd_enable() {
  local sd; sd="$(share_dir)"
  touch "$RC"
  local changed=0 f file marker feats; feats="$(expand_features "$@")"
  for f in $feats; do
    if ! file="$(feature_file "$f")"; then
      echo "rigor: unknown feature '$f' (try: autovenv, pyf, envup, all)" >&2; continue
    fi
    if feature_enabled "$f"; then
      echo "already enabled: $f"
      continue
    fi
    marker="# rigor:$f"
    printf 'source "%s/%s"  %s\n' "$sd" "$file" "$marker" >> "$RC"
    echo "enabled: $f"
    changed=1
  done
  # autovenv wants to be the sole venv manager — offer to stop editors from
  # auto-activating a venv in every terminal (see _editor_defer).
  case " $feats " in *" autovenv "*) _editor_defer ;; esac
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_disable() {
  # Require an explicit feature, so a bare `rigor disable` can't wipe everything
  # by accident. Use `rigor disable all` to turn them all off.
  if [ "$#" -eq 0 ]; then
    echo "rigor: pick a feature to disable: autovenv, pyf, envup (or 'all')" >&2
    return 2
  fi
  [ -f "$RC" ] || { echo "nothing to do (no $RC)"; return 0; }
  local changed=0 f tmp shim feats; feats="$(expand_features "$@")"
  for f in $feats; do
    if feature_enabled "$f"; then
      tmp="$(mktemp "${RC}.rigor.XXXXXX")"
      # Drop the feature's line(s); for pyf also drop the legacy py-fallback
      # marker. Also drop the pre-rename 'devrig:' and pre-pre-rename 'ezenv:'
      # markers so a not-yet-migrated rc is fully cleaned in one pass, not
      # left with a dangling old line.
      # `|| true`: grep exits 1 when it filters out the only line (empty
      # output), which must not abort the removal or trip `set -e`.
      if [ "$f" = pyf ]; then
        grep -vF "# rigor:pyf" "$RC" \
          | grep -vF "# rigor:py-fallback" \
          | grep -vF "# devrig:pyf" \
          | grep -vF "# devrig:py-fallback" \
          | grep -vF "# ezenv:pyf" \
          | grep -vF "# ezenv:py-fallback" > "$tmp" || true
      else
        grep -vF "# rigor:$f" "$RC" \
          | grep -vF "# devrig:$f" \
          | grep -vF "# ezenv:$f" > "$tmp" || true
      fi
      mv "$tmp" "$RC"
      echo "disabled: $f"
      changed=1
    else
      echo "not enabled: $f"
    fi
    # Clean up pyf's shim dir so disable leaves nothing behind — the current
    # path and both pre-rename ones, in case they were never migrated.
    if [ "$f" = pyf ]; then
      shim="${RIGOR_SHIM_DIR:-${DEVRIG_SHIM_DIR:-${EZENV_SHIM_DIR:-$HOME/.local/share/rigor/shims}}}"
      if [ -d "$shim" ]; then rm -rf "$shim"; echo "removed shims: $shim"; fi
      if [ -z "${RIGOR_SHIM_DIR:-}${DEVRIG_SHIM_DIR:-}" ] && [ -d "$HOME/.local/share/devrig/shims" ]; then
        rm -rf "$HOME/.local/share/devrig/shims"
        echo "removed shims: ~/.local/share/devrig/shims"
      fi
      if [ -z "${RIGOR_SHIM_DIR:-}${DEVRIG_SHIM_DIR:-}${EZENV_SHIM_DIR:-}" ] && [ -d "$HOME/.local/share/ezenv/shims" ]; then
        rm -rf "$HOME/.local/share/ezenv/shims"
        echo "removed shims: ~/.local/share/ezenv/shims"
      fi
    fi
  done
  # If we're turning autovenv off, offer to give the editor its venv activation
  # back (undo what _editor_defer did).
  case " $feats " in *" autovenv "*) _editor_restore ;; esac
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_status() {
  echo "rc file : $RC"
  local f
  for f in autovenv pyf envup; do
    if feature_enabled "$f"; then
      echo "  $f : enabled"
    else
      echo "  $f : disabled"
    fi
  done
  # Per-directory git/ssh/GitHub accounts used to live here as `devrig
  # account`. They moved to gitplus as `gw account`, because every gp-*
  # command needs to resolve the bound account before calling gh — so the
  # registry belongs with the git tooling, not a shell-helper package.
  # Existing config keeps working: `gw account` reads the sentinels this
  # wrote. Mentioned here rather than dropped silently, since `rigor status`
  # used to list accounts and someone will wonder where they went.
  if command -v gp-account >/dev/null 2>&1 && [ -n "$(gp-account list 2>/dev/null | head -1)" ]; then
    echo "accounts: see 'gw account list'"
  fi
  # push is not an rc feature, so it has no line above. Reported anyway: it
  # changes what your phone does, and `rigor status` is where you look.
  if [ -f "$PUSH_CLAUDE" ] && grep -q 'rigor/push/claude-' "$PUSH_CLAUDE" 2>/dev/null; then
    echo "  push : wired — see 'gw notify status'"
  fi
}

cmd_doctor() {
  echo "rigor $VERSION"
  echo "share dir   : $(share_dir)"
  echo "python      : $(command -v python || echo '<not found>')"
  echo "python3     : $(command -v python3 || echo '<not found>')"
  echo "pip         : $(command -v pip || echo '<not found>')"
  echo "pip3        : $(command -v pip3 || echo '<not found>')"
  echo "VIRTUAL_ENV : ${VIRTUAL_ENV:-<none>}"
}

cmd_sleep() {
  case "${1:-}" in
    off)
      sudo pmset -a disablesleep 1
      echo "sleep disabled — this Mac won't sleep until 'rigor sleep on'"
      ;;
    on)
      sudo pmset -a disablesleep 0
      echo "sleep re-enabled"
      ;;
    status)
      local v
      v="$(pmset -g | awk '/SleepDisabled/ {print $2}')"
      if [ "$v" = "1" ]; then
        echo "sleep disabled (rigor sleep on to re-enable)"
      else
        echo "sleep enabled (normal)"
      fi
      ;;
    *)
      echo "rigor sleep: specify 'on', 'off', or 'status'" >&2
      return 1
      ;;
  esac
}

# --- push -------------------------------------------------------------------
# Claude Code and Codex both end a turn and then wait. If you walked away, you
# find out when you come back. This wires each one's own notification hook to
# an ntfy topic your phone subscribes to, so several machines report to one
# subscription and each notification says which machine it came from.
#
# Not an `enable`-able feature: it writes no rc line. Like `sleep`, it reaches
# outside the shell — into Claude Code's settings.json and Codex's config.toml
# — so it is a one-off per machine rather than something a shell sources.
#
# All JSON and TOML editing is done in perl with core JSON::PP, deliberately.
# jq would be the obvious tool and is not a dependency of this package; making
# it one for a single optional feature would tax every install.
PUSH_ENV_DEFAULT="$HOME/.config/rigor/push.env"
PUSH_CLAUDE="${RIGOR_PUSH_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
PUSH_CODEX="${RIGOR_PUSH_CODEX_CONF:-$HOME/.codex/config.toml}"

push_dir() { echo "$(share_dir)/push"; }

# Where config is read from: an explicit override, else the current location,
# else the standalone installer's location that predated this feature.
_push_conf_read() {
  if [ -n "${RIGOR_PUSH_ENV:-}" ]; then echo "$RIGOR_PUSH_ENV"; return; fi
  if [ -r "$PUSH_ENV_DEFAULT" ]; then echo "$PUSH_ENV_DEFAULT"; return; fi
  if [ -r "$HOME/.config/rigorish/push.env" ]; then echo "$HOME/.config/rigorish/push.env"; return; fi
  if [ -r "$HOME/.config/phone-push.env" ]; then echo "$HOME/.config/phone-push.env"; return; fi
  echo "$PUSH_ENV_DEFAULT"
}
_push_conf_write() { echo "${RIGOR_PUSH_ENV:-$PUSH_ENV_DEFAULT}"; }
_push_passthrough() { echo "$HOME/.config/rigor/codex-passthrough"; }

_push_backup() {  # keep a copy beside the file, the same way autovenv does
  [ -f "$1" ] || return 0
  cp "$1" "$1.rigor-bak"
}

_push_load() {
  local c; c="$(_push_conf_read)"
  if [ -r "$c" ]; then
    # shellcheck disable=SC1090
    . "$c" 2>/dev/null || true
  fi
  NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
  # ${x+set} and not ${x:-}: an empty RIGOR_PUSH_DEVICE is a deliberate "leave
  # the device out of the title", and must not be refilled with the hostname.
  if [ -z "${RIGOR_PUSH_DEVICE+set}" ]; then
    RIGOR_PUSH_DEVICE="${PHONE_PUSH_DEVICE-$(hostname -s 2>/dev/null || echo host)}"
  fi
  RIGOR_PUSH_MIN_SECONDS="${RIGOR_PUSH_MIN_SECONDS:-${PHONE_PUSH_MIN_SECONDS:-60}}"
}

_push_setup() {
  local topic="" device="" server="" device_set=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --topic)  topic="${2:-}"; shift 2 ;;
      # device_set, so that --device '' is honored as "drop it from the title"
      # rather than read as "no --device given".
      --device) device="${2:-}"; device_set=1; shift 2 ;;
      --server) server="${2:-}"; shift 2 ;;
      *) echo "gw notify setup: unknown option '$1'" >&2; return 2 ;;
    esac
  done

  local pd; pd="$(push_dir)"
  if [ ! -x "$pd/send" ]; then
    echo "rigor push: helper scripts not found in $pd" >&2
    return 1
  fi

  # Read the existing config first, so a re-run never rotates the topic out
  # from under devices already subscribed to it.
  _push_load
  [ -n "$topic" ]  && NTFY_TOPIC="$topic"
  [ -n "$server" ] && NTFY_SERVER="$server"
  [ "$device_set" = 1 ] && RIGOR_PUSH_DEVICE="$device"
  local fresh=0
  if [ -z "${NTFY_TOPIC:-}" ]; then
    local rand
    rand="$(openssl rand -hex 6 2>/dev/null || uuidgen | tr -d - | cut -c1-12)"
    NTFY_TOPIC="agents-$rand"
    fresh=1
  fi

  local cw; cw="$(_push_conf_write)"
  mkdir -p "$(dirname "$cw")"
  cat > "$cw" <<CONF
# rigor push — written by 'gw notify setup'. Keep this file private:
# on public ntfy.sh the topic name is the only thing protecting the feed.
NTFY_SERVER="$NTFY_SERVER"
NTFY_TOPIC="$NTFY_TOPIC"
# Shown in every notification title, so several machines stay distinguishable.
RIGOR_PUSH_DEVICE="$RIGOR_PUSH_DEVICE"
# Turns shorter than this do not notify — you had not walked away yet.
RIGOR_PUSH_MIN_SECONDS=$RIGOR_PUSH_MIN_SECONDS
CONF
  chmod 600 "$cw"
  if [ -n "$RIGOR_PUSH_DEVICE" ]; then
    echo "config    : ${cw/#$HOME/~}  (device \"$RIGOR_PUSH_DEVICE\")"
  else
    echo "config    : ${cw/#$HOME/~}  (no device in the title)"
  fi

  # Claude Code: three hooks. UserPromptSubmit stamps the turn start, Stop
  # pushes only past the threshold, Notification pushes whenever Claude is
  # blocked on you and does not wait for the threshold.
  mkdir -p "$(dirname "$PUSH_CLAUDE")"
  _push_backup "$PUSH_CLAUDE"
  if "$pd/wire-claude" on "$pd" "$PUSH_CLAUDE"; then
    echo "claude    : 3 hooks wired in ${PUSH_CLAUDE/#$HOME/~}"
  else
    echo "claude    : failed to wire ${PUSH_CLAUDE/#$HOME/~}" >&2
  fi

  # Codex: one notify slot, and something else may already hold it — on a Mac
  # with the ChatGPT app, its own desktop notifier does. wire-codex parks that
  # argv and codex-notify replays it, so taking the slot costs nothing.
  if [ -f "$PUSH_CODEX" ]; then
    mkdir -p "$(dirname "$(_push_passthrough)")"
    _push_backup "$PUSH_CODEX"
    local r
    if r="$("$pd/wire-codex" on "$pd/codex-notify" "$PUSH_CODEX" "$(_push_passthrough)")"; then
      echo "codex     : notify slot taken — $r"
    else
      echo "codex     : failed to wire ${PUSH_CODEX/#$HOME/~}" >&2
    fi
  else
    echo "codex     : not installed here, skipped"
  fi

  echo
  echo "Subscribe your phone to topic '$NTFY_TOPIC' at $NTFY_SERVER (ntfy app)."
  if [ "$fresh" = 1 ]; then
    echo "On your other machines:  gw notify setup --topic $NTFY_TOPIC"
  fi
  echo "Then check it end to end:  gw notify test"
}

_push_status() {
  local show=0
  [ "${1:-}" = "--show" ] && show=1
  _push_load
  local c; c="$(_push_conf_read)"
  if [ ! -r "$c" ] || [ -z "${NTFY_TOPIC:-}" ]; then
    echo "not set up — run: gw notify setup"
    return 0
  fi
  echo "config    : ${c/#$HOME/~}"
  if [ "$show" = 1 ]; then
    echo "topic     : $NTFY_TOPIC"
  else
    # Masked by default: the topic is the credential, and status output ends up
    # in screenshots. --show prints it for setting up the next device.
    local keep=4 pad
    [ "${#NTFY_TOPIC}" -lt 8 ] && keep=0        # too short to reveal any of it
    pad=$(( ${#NTFY_TOPIC} - keep ))
    echo "topic     : ${NTFY_TOPIC:0:$keep}$(printf '%*s' "$pad" '' | tr ' ' '*')  (--show to reveal)"
  fi
  echo "server    : $NTFY_SERVER"
  if [ -n "$RIGOR_PUSH_DEVICE" ]; then
    echo "device    : $RIGOR_PUSH_DEVICE"
  else
    echo "device    : (not shown in titles)"
  fi
  echo "quiet under: ${RIGOR_PUSH_MIN_SECONDS}s"
  if [ -f "$PUSH_CLAUDE" ] && grep -q 'rigor/push/claude-' "$PUSH_CLAUDE" 2>/dev/null; then
    echo "claude    : wired"
  else
    echo "claude    : not wired"
  fi
  if [ -f "$PUSH_CODEX" ] && grep -q 'push/codex-notify' "$PUSH_CODEX" 2>/dev/null; then
    local p; p="$(_push_passthrough)"
    if [ -s "$p" ]; then
      echo "codex     : wired, replaying $(head -1 "$p" | xargs basename 2>/dev/null || echo 'a previous notifier')"
    else
      echo "codex     : wired"
    fi
  elif [ -f "$PUSH_CODEX" ]; then
    echo "codex     : not wired"
  else
    echo "codex     : not installed here"
  fi
}

# Send one notification, then read the topic back. Delivery is the only thing
# worth reporting here: `send` exits 0 even when nothing goes out, by design,
# so its exit status proves nothing.
_push_test() {
  _push_load
  if [ -z "${NTFY_TOPIC:-}" ]; then
    echo "not set up — run: gw notify setup" >&2
    return 1
  fi
  local msg="${*:-gw notify test}"
  "$(push_dir)/send" "rigor" "$msg" default bell
  sleep 2
  if curl -fsS --max-time 15 "${NTFY_SERVER%/}/${NTFY_TOPIC}/json?poll=1&since=1m" 2>/dev/null \
       | grep -qF "$msg"; then
    echo "delivered — the topic has it. If your phone stayed quiet, check the"
    echo "ntfy app is subscribed to '$NTFY_TOPIC' and notifications are allowed."
  else
    echo "not delivered. Check network access to ${NTFY_SERVER}." >&2
    return 1
  fi
}

_push_off() {
  local pd; pd="$(push_dir)"
  if [ -f "$PUSH_CLAUDE" ]; then
    _push_backup "$PUSH_CLAUDE"
    "$pd/wire-claude" off "$PUSH_CLAUDE" && echo "claude    : hooks removed"
  fi
  if [ -f "$PUSH_CODEX" ] && grep -q 'push/codex-notify' "$PUSH_CODEX" 2>/dev/null; then
    _push_backup "$PUSH_CODEX"
    local r
    r="$("$pd/wire-codex" off "$PUSH_CODEX" "$(_push_passthrough)")" \
      && echo "codex     : $r"
  fi
  # The config file stays. It holds the topic, and deleting it would strand any
  # other device still subscribed to it behind a topic nobody can recover.
  echo "config    : kept at $(_push_conf_read | sed "s|^$HOME|~|") — delete it to forget the topic"
}

cmd_push() {
  local sub="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$sub" in
    setup)  _push_setup "$@" ;;
    status) _push_status "$@" ;;
    test)   _push_test "$@" ;;
    off)    _push_off ;;
    *)
      cat >&2 <<'EOF'
gw notify: specify a subcommand

  gw notify setup [--topic T] [--device NAME] [--server URL]
      --device '' leaves this machine out of the notification titles
  gw notify status [--show]
  gw notify test [message]
  gw notify off

Notifies your phone when a Claude Code or Codex turn ends, via ntfy.
EOF
      return 1 ;;
  esac
}

# --- identity ----------------------------------------------------------------
# Per-directory gh account and AWS profile, applied by gh/aws shims on PATH
# rather than by a shell hook. A hook only runs in interactive shells, and
# agents (Claude Code, Codex), git's credential helper and scripts never get
# one — so they fall back to gh's one machine-wide active account and AWS's
# [default], and end up telling you to log in as somebody else. A shim is
# consulted by every process that finds gh/aws on PATH.
IDENT_BIN="${RIGOR_IDENTITY_BIN:-$HOME/.local/share/rigor/identity/bin}"
IDENT_MAP="${RIGOR_AWS_PROFILES:-$HOME/.config/rigor/aws-profiles}"
IDENT_GIT_SAVE="${RIGOR_IDENTITY_GIT_SAVE:-$HOME/.config/rigor/identity-git-helpers}"
IDENT_MARK="# rigor:identity"
# Both files, on purpose: .zshenv is the only one non-interactive `zsh -c`
# reads (what agents run), but on macOS /etc/zprofile runs path_helper after
# it in login shells, which moves /usr/local/bin and friends back in front —
# so the shim dir is re-prepended from .zprofile too.
IDENT_ZSHENV="${RIGOR_ZSHENV:-${ZDOTDIR:-$HOME}/.zshenv}"
IDENT_ZPROFILE="${RIGOR_ZPROFILE:-${ZDOTDIR:-$HOME}/.zprofile}"
# Claude Code's Bash sandbox hides the keychain and the network from gh, aws
# and git, so the shims alone can't help a sandboxed agent; setup also lists
# those commands in sandbox.excludedCommands.
IDENT_CLAUDE="${RIGOR_IDENTITY_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
IDENT_CLAUDE_REC="${RIGOR_IDENTITY_CLAUDE_RECORD:-$HOME/.config/rigor/identity-claude-excluded}"

# Same preference as share_dir(), except a Homebrew keg older than this
# feature has no identity/ yet — fall back to wherever this script lives.
_ident_src() {
  local sd; sd="$(share_dir)"
  if [ -x "$sd/identity/gh" ]; then echo "$sd/identity"; else echo "$SHARE/identity"; fi
}

_ident_path_line() {
  # ${path:#dir} drops an existing copy, so this moves the dir to the front
  # instead of skipping when path_helper has already pushed it back.
  printf '[ -d "%s" ] && path=("%s" ${path:#%s})  %s\n' \
    "$IDENT_BIN" "$IDENT_BIN" "$IDENT_BIN" "$IDENT_MARK"
}

_ident_pattern() {  # a directory as it's written in the map: ~-relative when possible
  # Normalized the same way `pwd` normalized $1 (a HOME with a trailing or
  # doubled slash would otherwise never prefix-match).
  local h; h="$(cd "$HOME" 2>/dev/null && pwd)" || h="$HOME"
  case "$1" in
    "$h"|"$h"/*) echo "~${1#"$h"}" ;;
    *) echo "$1" ;;
  esac
}

# Point any `gh auth git-credential` helper in the global git config at the
# shim, so HTTPS pushes authenticate as the directory's account too. The
# originals are saved for `off` to put back.
_ident_git_route() {
  command -v git >/dev/null 2>&1 || return 0
  local key val n=0 found=0
  while read -r key val; do
    case "$val" in
      *"$IDENT_BIN/gh "*) found=1; continue ;;
      "!"*"gh auth git-credential") ;;
      *) continue ;;
    esac
    mkdir -p "$(dirname "$IDENT_GIT_SAVE")"
    printf '%s\t%s\n' "$key" "$val" >>"$IDENT_GIT_SAVE"
    git config --global --replace-all "$key" "!$IDENT_BIN/gh auth git-credential" \
      '^!.*gh auth git-credential$'
    n=$((n + 1))
  done < <(git config --global --get-regexp '^credential\..*\.helper$' 2>/dev/null || true)
  if [ "$n" -gt 0 ]; then
    echo "git       : $n credential helper(s) now go through the gh shim"
  elif [ "$found" = 1 ]; then
    echo "git       : credential helper already goes through the gh shim"
  else
    echo "git       : no gh credential helper configured — left alone"
  fi
}

_ident_git_restore() {
  [ -f "$IDENT_GIT_SAVE" ] || return 0
  local key val
  while IFS=$'\t' read -r key val; do
    [ -n "$key" ] || continue
    git config --global --replace-all "$key" "$val" 'rigor/identity/bin/gh auth git-credential'
  done <"$IDENT_GIT_SAVE"
  rm -f "$IDENT_GIT_SAVE"
  echo "git       : credential helper(s) restored"
}

_ident_claude_on() {
  # No Claude Code here: nothing to wire, and creating its settings file would
  # be presumptuous.
  [ -d "$(dirname "$IDENT_CLAUDE")" ] || return 0
  local n
  mkdir -p "$(dirname "$IDENT_CLAUDE_REC")"
  _push_backup "$IDENT_CLAUDE"
  if n="$("$(_ident_src)/wire-claude" on "$IDENT_CLAUDE" "$IDENT_CLAUDE_REC")"; then
    if [ "$n" -gt 0 ]; then
      echo "claude    : $n command pattern(s) let out of the Bash sandbox (gh, aws, git network)"
    else
      echo "claude    : gh, aws and git network commands already outside the sandbox"
    fi
  else
    echo "claude    : not changed — see the error above" >&2
  fi
}

_ident_claude_off() {
  [ -f "$IDENT_CLAUDE_REC" ] && [ -f "$IDENT_CLAUDE" ] || return 0
  local n
  _push_backup "$IDENT_CLAUDE"
  if n="$("$(_ident_src)/wire-claude" off "$IDENT_CLAUDE" "$IDENT_CLAUDE_REC")"; then
    echo "claude    : removed the $n sandbox exclusion(s) setup added"
  fi
}

_ident_setup() {
  local src; src="$(_ident_src)"
  if [ ! -x "$src/gh" ] || [ ! -x "$src/aws" ]; then
    echo "rigor identity: shims not found in $src" >&2
    return 1
  fi
  mkdir -p "$IDENT_BIN"
  ln -sfn "$src/gh" "$IDENT_BIN/gh"
  ln -sfn "$src/aws" "$IDENT_BIN/aws"
  echo "shims     : ${IDENT_BIN/#$HOME/~} (gh, aws)"

  local f
  for f in "$IDENT_ZSHENV" "$IDENT_ZPROFILE"; do
    if [ -f "$f" ] && grep -qF "$IDENT_MARK" "$f"; then
      echo "path      : already in ${f/#$HOME/~}"
      continue
    fi
    _push_backup "$f"
    _ident_path_line >>"$f"
    echo "path      : prepended from ${f/#$HOME/~}"
  done

  _ident_git_route
  _ident_claude_on

  if [ ! -f "$IDENT_MAP" ]; then
    mkdir -p "$(dirname "$IDENT_MAP")"
    cat >"$IDENT_MAP" <<'EOF'
# <dir-glob> <aws profile> — read by rigor's aws shim. First match wins, so
# specific directories go above their parents; `gw aws bind` keeps
# that order. A directory matches itself and everything below it.
EOF
    echo "aws map   : created ${IDENT_MAP/#$HOME/~}"
  fi

  # The shims pick the right account; this makes sure that account's ssh key
  # actually works. A refused key needs one browser approval to fix, so only
  # with someone at the terminal — otherwise say what to run.
  if command -v gp-account >/dev/null 2>&1; then
    echo
    if [ -t 0 ] && [ -t 1 ]; then
      echo "Checking each account's ssh key with GitHub (gw account check --fix):"
      gp-account check --fix || true
    else
      echo "ssh keys  : not checked (no terminal) — run: gw account check --fix"
    fi
  fi

  echo
  echo "Bind directories:  gw aws bind <aws-profile> [dir]"
  echo "                   gw account bind <name> <dir>"
  echo "Then open a new shell (and restart agent apps) and check: gw account status"
}

_ident_resolve() {  # <gh|aws> — what the shim would use in $PWD
  local s="$IDENT_BIN/$1"
  [ -x "$s" ] || s="$(_ident_src)/$1"
  RIGOR_IDENTITY_RESOLVE=1 "$s" 2>/dev/null || true
}

_ident_status() {
  local t r
  if [ -x "$IDENT_BIN/gh" ] && [ -x "$IDENT_BIN/aws" ]; then
    echo "shims     : ${IDENT_BIN/#$HOME/~}"
  else
    echo "not set up — run: gw account setup"
    return 0
  fi
  for t in gh aws; do
    r="$(command -v "$t" 2>/dev/null || true)"
    if [ -n "$r" ] && [ "$r" -ef "$IDENT_BIN/$t" ]; then
      printf 'path      : %-3s -> shim\n' "$t"
    else
      printf 'path      : %-3s -> %s  (shim not first on PATH — open a new shell)\n' "$t" "${r:-not found}"
    fi
  done
  if git config --global --get-regexp '^credential\..*\.helper$' 2>/dev/null | grep -qF "$IDENT_BIN/gh"; then
    echo "git       : credential helper via shim"
  elif git config --global --get-regexp '^credential\..*\.helper$' 2>/dev/null | grep -qF 'gh auth git-credential'; then
    echo "git       : credential helper bypasses the shim — run: gw account setup"
  fi
  if [ -f "$IDENT_CLAUDE" ]; then
    echo "claude    : $("$(_ident_src)/wire-claude" status "$IDENT_CLAUDE" 2>&1)"
  fi

  echo "here      : ${PWD/#$HOME/~}"
  r="$(_ident_resolve gh)"
  case "$r" in
    env) echo "  gh      : GH_TOKEN/GITHUB_TOKEN from the environment (wins over bindings)" ;;
    "")  if command -v gp-account >/dev/null 2>&1; then
           echo "  gh      : unbound — gh's active account (bind: gw account bind <name> <dir>)"
         else
           echo "  gh      : account tools (gp-account) not found — gh's active account"
         fi ;;
    *)   echo "  gh      : $r" ;;
  esac
  r="$(_ident_resolve aws)"
  case "$r" in
    env) echo "  aws     : AWS_PROFILE/AWS_ACCESS_KEY_ID from the environment (wins over bindings)" ;;
    "")  echo "  aws     : unbound — [default] (bind: gw aws bind <profile>)" ;;
    *)   echo "  aws     : $r" ;;
  esac

  echo "aws map   : ${IDENT_MAP/#$HOME/~}"
  if [ -r "$IDENT_MAP" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$IDENT_MAP" | sed 's/^/  /' || true
  fi
}

_ident_bind() {
  local prof="${1:-}" dir="${2:-$PWD}"
  if [ -z "$prof" ]; then
    echo "usage: gw aws bind <aws-profile> [dir]" >&2
    return 2
  fi
  dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "rigor identity: no such directory: ${2:-}" >&2; return 1; }
  if ! RIGOR_IDENTITY_OFF=1 aws configure list-profiles 2>/dev/null | grep -qxF "$prof"; then
    echo "warning: no AWS profile '$prof' in your aws config — binding it anyway" >&2
  fi
  local pat; pat="$(_ident_pattern "$dir")"
  mkdir -p "$(dirname "$IDENT_MAP")"
  touch "$IDENT_MAP"

  # Insert above the first entry that already covers this directory (a
  # parent), so the more specific binding is the one that matches first.
  local tmp line p e inserted=0
  tmp="$(mktemp "$IDENT_MAP.rigor.XXXXXX")"
  while IFS= read -r line || [ -n "$line" ]; do
    read -r p _ <<<"$line"
    if [ -n "$p" ] && [ "${p#\#}" = "$p" ]; then
      [ "$p" = "$pat" ] && continue        # rebinding: the old line goes
      e="${p/#\~/$HOME}"
      # shellcheck disable=SC2053  # $e is a glob
      if [ "$inserted" = 0 ] && [[ "$dir/" == $e/* ]]; then
        printf '%s %s\n' "$pat" "$prof"
        inserted=1
      fi
    fi
    printf '%s\n' "$line"
  done <"$IDENT_MAP" >"$tmp"
  [ "$inserted" = 1 ] || printf '%s %s\n' "$pat" "$prof" >>"$tmp"
  mv "$tmp" "$IDENT_MAP"
  echo "bound $pat -> $prof"
}

_ident_unbind() {
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || dir="${1:-}"
  local pat; pat="$(_ident_pattern "$dir")"
  [ -f "$IDENT_MAP" ] || { echo "nothing bound"; return 0; }
  local tmp line p n=0
  tmp="$(mktemp "$IDENT_MAP.rigor.XXXXXX")"
  while IFS= read -r line || [ -n "$line" ]; do
    read -r p _ <<<"$line"
    if [ "$p" = "$pat" ]; then n=$((n + 1)); continue; fi
    printf '%s\n' "$line"
  done <"$IDENT_MAP" >"$tmp"
  mv "$tmp" "$IDENT_MAP"
  if [ "$n" -gt 0 ]; then echo "unbound $pat"; else echo "$pat was not bound"; fi
}

_ident_off() {
  local f tmp
  for f in "$IDENT_ZSHENV" "$IDENT_ZPROFILE"; do
    [ -f "$f" ] && grep -qF "$IDENT_MARK" "$f" || continue
    _push_backup "$f"
    tmp="$(mktemp "$f.rigor.XXXXXX")"
    grep -vF "$IDENT_MARK" "$f" >"$tmp" || true
    cat "$tmp" >"$f"     # in place, so a symlinked dotfile stays a symlink
    rm -f "$tmp"
    echo "path      : removed from ${f/#$HOME/~}"
  done
  _ident_git_restore
  _ident_claude_off
  if [ -d "$IDENT_BIN" ]; then
    rm -rf "$IDENT_BIN"
    echo "shims     : removed"
  fi
  # Bindings are hand-curated and cheap to keep; deleting them would make
  # off-then-setup lose work.
  [ -f "$IDENT_MAP" ] && echo "aws map   : kept at ${IDENT_MAP/#$HOME/~}"
  return 0
}

cmd_identity() {
  local sub="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$sub" in
    setup)  _ident_setup ;;
    status) _ident_status ;;
    bind)   _ident_bind "$@" ;;
    unbind) _ident_unbind "$@" ;;
    off)    _ident_off ;;
    *)
      cat >&2 <<'EOF'
gw account: specify a subcommand

  gw account setup               Install gh/aws shims and put them on PATH
  gw account status              What's wired, and what applies here
  gw account off                 Unwire, restoring what was there before
  gw aws bind <profile> [dir]    Use that AWS profile in dir and below
  gw aws unbind [dir]

GitHub accounts are bound with: gw account bind <name> <dir>.
EOF
      return 1 ;;
  esac
}

cmd_init() {
  local sd; sd="$(share_dir)"
  local f file
  for f in $(expand_features "$@"); do
    if ! file="$(feature_file "$f")"; then
      echo "rigor: unknown feature '$f' (try: autovenv, pyf, envup, all)" >&2; return 1
    fi
    printf 'source "%s/%s"\n' "$sd" "$file"
  done
}

case "${1:-help}" in
  enable|install)       shift; cmd_enable "$@" ;;   # 'install' kept as a back-compat alias
  disable|uninstall|remove) shift; cmd_disable "$@" ;;
  status)               cmd_status ;;
  doctor)               cmd_doctor ;;
  init)                 shift; cmd_init "$@" ;;
  # Kept as a signpost rather than removed: anyone with the old command in
  # muscle memory or a script deserves to be told where it went, not a bare
  # usage dump. Forwards the arguments so the suggestion is runnable as-is.
  account|accounts)
    shift
    echo "rigor: accounts live under gw account — run: gw account${*:+ $*}" >&2
    echo "  (your existing accounts and bindings still work there, unchanged)" >&2
    exit 1 ;;
  sleep)                shift; cmd_sleep "$@" ;;
  push)                 shift; cmd_push "$@" ;;
  identity|id)          shift; cmd_identity "$@" ;;
  version|--version|-v) echo "rigor $VERSION" ;;
  help|--help|-h)       usage ;;
  *)                    usage >&2; exit 1 ;;
esac
